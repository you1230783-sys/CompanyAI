* text=auto
*.rs text eol=lf
*.py text eol=lf
assets/python-runtime-manifest.json -text
*.md text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bin binary
*.blob binary

# 執行檔與離線包都納入 Git；大型內容由 Git LFS 儲存。
dist/*.exe filter=lfs diff=lfs merge=lfs -text
offline/*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve upstream license text, including its original trailing spaces.
ui/vendor/pdf.NOTICES.txt -whitespace

# Preserve the pinned upstream ECharts bytes and published SHA256 across checkouts.
ui/vendor/echarts.min.js text eol=lf
ui/vendor/ECHARTS-LICENSE.txt text eol=lf
ui/vendor/ECHARTS-NOTICE.txt text eol=lf
